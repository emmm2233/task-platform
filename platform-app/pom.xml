<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.dsh.platform</groupId>
        <artifactId>task-platform</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>platform-app</artifactId>
    <name>platform-app</name>
    <description>主应用：9 个限界上下文（identity/task/award/order/wallet/dispute/im/notify/admin）</description>

    <properties>
        <!--
          ⭐ 测试必须连【测试库】，不能连 dev 库。

          踩过的坑（独立审计实测）：此前 20 个 @SpringBootTest 用默认 dev profile，
          读 application-dev.yml 里硬编码的 task_platform，而其中 3 个类的 @BeforeEach
          执行的是【全库】语句（DELETE FROM wallet_txn / UPDATE wallet_account ...），
          ⇒ 跑一次 mvn test 就清掉 dev 库的账本分录与全部用户余额。

          这里用 Maven 属性 + surefire systemPropertyVariables 覆盖，
          而不是加 src/test/resources/application-dev.yml ——
          同名文件会让 test-classes 的版本【完全取代】main 版本，
          连带丢掉 redis / jwt / platform.* 配置。

          ⛔ CI 可通过 -Dtest.db.url=... 指向自己的库。
        -->
        <test.db.url>jdbc:mysql://127.0.0.1:3306/task_platform_test?useUnicode=true&amp;characterEncoding=UTF-8&amp;serverTimezone=Asia/Shanghai&amp;useSSL=false&amp;allowPublicKeyRetrieval=true&amp;rewriteBatchedStatements=true</test.db.url>
        <test.db.username>root</test.db.username>
        <test.db.password>123456</test.db.password>
        <!-- 测试用独立的 Redis 库号：避免清掉【运行中应用】的短信限流计数 -->
        <test.redis.database>15</test.redis.database>
        <!-- ⛔ CI 里 Redis 是 service 别名（redis），必须能覆盖 host：
             修复前 CI 定义了 TEST_REDIS_HOST 却没有【任何代码读取它】，
             surefire 只覆盖了 database ⇒ CI 上测试连的是 127.0.0.1:6379（容器里的自己）。 -->
        <test.redis.host>127.0.0.1</test.redis.host>
    </properties>

    <dependencies>
        <dependency>
            <groupId>com.dsh.platform</groupId>
            <artifactId>platform-common</artifactId>
            <version>${project.version}</version>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <!-- @Aspect 审计切面需要（spring-boot-starter-web 不再默认带入 AOP） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-aop</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>

        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-spring-boot3-starter</artifactId>
        </dependency>
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-mysql</artifactId>
        </dependency>

        <dependency>
            <groupId>org.redisson</groupId>
            <artifactId>redisson-spring-boot-starter</artifactId>
        </dependency>

        <!-- JWT：访问令牌用 HS256 签名。api 编译期、impl/jackson 运行期 -->
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-api</artifactId>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-impl</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-jackson</artifactId>
            <scope>runtime</scope>
        </dependency>

        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
        </dependency>

        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <scope>provided</scope>
        </dependency>

        <!-- 测试 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>mysql</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!--
              ⭐ 把测试指向【测试库 + 独立 Redis 库号】，而不是 dev 环境。
              系统属性优先级高于 YAML，所以这里能盖住 application-dev.yml 的值。
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <systemPropertyVariables>
                        <spring.datasource.url>${test.db.url}</spring.datasource.url>
                        <spring.datasource.username>${test.db.username}</spring.datasource.username>
                        <spring.datasource.password>${test.db.password}</spring.datasource.password>
                        <!-- ⭐ host 也要能覆盖：CI 里 Redis 是 service 别名 redis，不是 127.0.0.1。
                             修复前只覆盖了 database，CI 传的 TEST_REDIS_HOST 没有任何代码读取
                             ⇒ 测试连不上 Redis（本机绿、CI 红）。 -->
                        <spring.data.redis.host>${test.redis.host}</spring.data.redis.host>
                        <spring.data.redis.database>${test.redis.database}</spring.data.redis.database>
                    </systemPropertyVariables>
                </configuration>
            </plugin>

            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <excludes>
                        <exclude>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </exclude>
                    </excludes>
                </configuration>
                <executions>
                    <!--
                      ⚠️ 必须显式绑定 repackage：本工程用的是自建父 pom（只 import BOM），
                         ⛔ 没有继承 spring-boot-starter-parent，因此 Spring Boot 的
                         默认执行绑定不会自动生效 —— 不加这段，package 只会产出瘦 jar。
                    -->
                    <execution>
                        <id>repackage-executable-jar</id>
                        <goals>
                            <goal>repackage</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

            <!--
              ⭐ 迁移脚本单一来源：仓库根 db/migration 是唯一事实来源，
                 构建时拷进 classpath:db/migration 供 Flyway 使用。
                 ⛔ 不要在 resources 下再放一份副本 —— 两份 DDL 必然漂移。
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-resources-plugin</artifactId>
                <version>3.3.1</version>
                <executions>
                    <execution>
                        <id>copy-flyway-migrations</id>
                        <phase>process-resources</phase>
                        <goals>
                            <goal>copy-resources</goal>
                        </goals>
                        <configuration>
                            <outputDirectory>${project.build.outputDirectory}/db/migration</outputDirectory>
                            <overwrite>true</overwrite>
                            <resources>
                                <resource>
                                    <directory>${project.basedir}/../db/migration</directory>
                                    <filtering>false</filtering>
                                    <includes>
                                        <include>*.sql</include>
                                    </includes>
                                </resource>
                            </resources>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
